<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="controllers.LoginController"
      spacing="14" alignment="CENTER"
      prefWidth="340" prefHeight="280">

    <padding><Insets top="30" right="30" bottom="30" left="30"/></padding>

    <Label text="Iniciar Sesión"
           style="-fx-font-size: 20px; -fx-font-weight: bold;"/>

    <VBox spacing="6">
        <Label text="Usuario"/>
        <TextField fx:id="txtUsername" promptText="usuario"/>
    </VBox>

    <VBox spacing="6">
        <Label text="Contraseña"/>
        <PasswordField fx:id="txtPassword" promptText="contraseña"/>
    </VBox>

    <Label fx:id="lblError"
           style="-fx-text-fill: red; -fx-font-size: 11px;"/>

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button fx:id="btnCancel" text="Cancelar"/>
        <Button fx:id="btnLogin" text="Ingresar" defaultButton="true"/>
    </HBox>
</VBox>
