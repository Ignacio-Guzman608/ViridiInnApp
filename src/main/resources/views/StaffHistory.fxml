<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox stylesheets="@/css/style.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controllers.StaffHistoryController"
      spacing="15" prefWidth="750" prefHeight="500">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <!-- Encabezado con Título (color oscuro) y Botón Reactivar más grande -->
    <HBox alignment="CENTER_LEFT" spacing="15">
        <!-- Usamos section-title para el color oscuro y evitamos el verde -->
        <Label text="Eliminados" styleClass="section-title" style="-fx-font-size: 24px;"/>
        <Region HBox.hgrow="ALWAYS"/>

        <!-- Botón Reactivar más grande y con estilo de botón primario -->
        <Button fx:id="btnReactivate" text="Reactivar" disable="true"
                styleClass="btn-primary"
                style="-fx-padding: 10 24; -fx-font-size: 14px;"/>
    </HBox>

    <!-- Barra de búsqueda -->
    <TextField fx:id="txtSearch" promptText="🔍 Buscar por nombre, apellido, email, teléfono..."
               styleClass="search-field" style="-fx-pref-height: 35px;"/>

    <!-- Tabla de inactivos -->
    <TableView fx:id="tableInactive" styleClass="customer-table" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colName" text="Nombre Completo" prefWidth="250"/>
            <TableColumn fx:id="colDni" text="DNI" prefWidth="150"/>
            <TableColumn fx:id="colPosition" text="Cargo" prefWidth="200"/>
        </columns>
    </TableView>

    <!-- Pie de página (Contador) -->
    <Label fx:id="lblFooter" text="Mostrando 0 empleados inactivos"
           style="-fx-text-fill: #7f8c8d; -fx-font-size: 12px;" />
</VBox>