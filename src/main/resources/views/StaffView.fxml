<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane stylesheets="@/css/style.css"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.StaffController">

    <VBox styleClass="content-main" spacing="15"
          AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0"
          AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0">
        <padding>
            <Insets top="20" right="20" bottom="20" left="20" />
        </padding>

        <!-- Título y botones superiores -->
        <HBox alignment="CENTER_LEFT" spacing="15">
            <Label text="Personal" styleClass="section-title">
                <font><Font size="24.0" /></font>
            </Label>
            <Region HBox.hgrow="ALWAYS" />
            <Button fx:id="btnNewStaff" text="Nuevo" styleClass="btn-primary" onAction="#handleNewStaff" />
            <Button fx:id="btnViewHistory" text="📁 Eliminados" styleClass="btn-secondary" onAction="#handleViewHistory" />
        </HBox>

        <!-- Buscador -->
        <HBox spacing="15" alignment="CENTER_LEFT">
            <TextField fx:id="txtSearch" promptText="🔍 Buscar por nombre, DNI, cargo..."
                       styleClass="search-field" HBox.hgrow="ALWAYS" />
        </HBox>

        <!-- SplitPane: Tabla + Detalle -->
        <!-- Cambiamos la división a 0.76 para darle más espacio a la tabla y achicar el panel -->
        <SplitPane dividerPositions="0.76" VBox.vgrow="ALWAYS" styleClass="split-pane">

            <VBox spacing="10">
                <TableView fx:id="tableStaff" styleClass="customer-table" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colFullName" text="Nombre Completo" prefWidth="150" />
                        <TableColumn fx:id="colPosition" text="Cargo" prefWidth="120" />
                        <TableColumn fx:id="colPhone" text="Teléfono" prefWidth="100" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
            </VBox>

            <!-- Panel de detalle tipo "tarjeta" flotante (como en Clientes) -->
            <!-- Le damos un ancho fijo más chico (260) y un margen a la izquierda -->
            <VBox spacing="15" style="-fx-background-color: white; -fx-background-radius: 8; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 0, 2);"
                  prefWidth="270" maxWidth="270">

                <!-- Margen interno del panel -->
                <padding>
                    <Insets top="20" right="20" bottom="20" left="20" />
                </padding>

                <!-- Contenedor con Scroll para los datos (por si la pantalla es chica) -->
                <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                            style="-fx-background-color: transparent; -fx-background: transparent;">
                    <VBox spacing="12">
                        <Label fx:id="lblDetailName" text="Nombre Completo" styleClass="detail-name" wrapText="true"/>

                        <VBox spacing="2">
                            <Label text="Cargo:" styleClass="detail-label" />
                            <Label fx:id="lblDetailPosition" text="--" styleClass="detail-value" />
                        </VBox>

                        <VBox spacing="2">
                            <Label text="Estado:" styleClass="detail-label" />
                            <Label fx:id="lblDetailStatus" text="--" styleClass="detail-value" />
                        </VBox>

                        <VBox spacing="2">
                            <Label text="DNI:" styleClass="detail-label" />
                            <Label fx:id="lblDetailDni" text="--" styleClass="detail-value" />
                        </VBox>

                        <VBox spacing="2">
                            <Label text="Fecha Nacimiento:" styleClass="detail-label" />
                            <Label fx:id="lblDetailBirthDate" text="--" styleClass="detail-value" />
                        </VBox>

                        <VBox spacing="2">
                            <Label text="Teléfono:" styleClass="detail-label" />
                            <Label fx:id="lblDetailPhone" text="--" styleClass="detail-value" />
                        </VBox>

                        <VBox spacing="2">
                            <Label text="Email:" styleClass="detail-label" />
                            <Label fx:id="lblDetailEmail" text="--" styleClass="detail-value" />
                        </VBox>

                        <VBox spacing="2">
                            <Label text="Dirección:" styleClass="detail-label" />
                            <Label fx:id="lblDetailAddress" text="--" styleClass="detail-value" wrapText="true" />
                        </VBox>

                        <VBox spacing="2">
                            <Label text="Contratación:" styleClass="detail-label" />
                            <Label fx:id="lblDetailHireDate" text="--" styleClass="detail-value" />
                        </VBox>

                        <VBox spacing="2">
                            <Label text="Turno:" styleClass="detail-label" />
                            <Label fx:id="lblDetailShift" text="--" styleClass="detail-value" />
                        </VBox>

                        <VBox spacing="2">
                            <Label text="Salario:" styleClass="detail-label" />
                            <Label fx:id="lblDetailSalary" text="--" styleClass="detail-value" />
                        </VBox>
                    </VBox>
                </ScrollPane>

                <!-- Zona de botones anclada al fondo del panel -->
                <VBox spacing="10">
                    <Button fx:id="btnEdit" text="Editar" maxWidth="Infinity" disable="true" onAction="#handleEdit" />
                    <Button fx:id="btnDeactivate" text="Eliminar" maxWidth="Infinity" disable="true" onAction="#handleDeactivate" />
                </VBox>

            </VBox>
        </SplitPane>
    </VBox>
</AnchorPane>